# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/memorioso"

# Memorioso session cookie signing
SESSION_SECRET="replace-with-a-generated-secret"

# Public app URL used in publication and author links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# World ID 4.0
NEXT_PUBLIC_WORLD_ID_APP_ID="app_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
WORLD_ID_RP_ID="rp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
WORLD_ID_RP_SIGNING_KEY="replace-with-server-only-rp-signing-key"
WORLD_ID_PUBLISH_ACTION="written-by-a-human-v4"
# Use "staging" for local simulator testing and "production" for deployed verification.
NEXT_PUBLIC_WORLD_ID_ENVIRONMENT="staging"
