{
  "name": "@libro/chrome-extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --mode production && vite build --mode production --config vite.content.config.ts",
    "build:stage": "vite build --mode stage && vite build --mode stage --config vite.content.config.ts",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@libro/core": "workspace:*",
    "@worldcoin/idkit": "4.2.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@types/chrome": "0.2.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "happy-dom": "20.0.0",
    "typescript": "5.7.3",
    "vite": "8.1.5",
    "vitest": "^4.1.6"
  }
}
