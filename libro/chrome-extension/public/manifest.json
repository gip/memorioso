{
  "manifest_version": 3,
  "name": "Libro Verifier",
  "version": "1.0.0",
  "description": "Verify and sign human-signed text through Libro without leaving the page.",
  "permissions": ["activeTab", "scripting", "sidePanel", "storage", "contextMenus", "clipboardWrite"],
  "host_permissions": [
    "https://worldchain-mainnet.g.alchemy.com/*",
    "https://bridge.worldcoin.org/*",
    "https://www.memorioso.xyz/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scan this page with Libro",
    "default_icon": "icon.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
