      "documents": [
        {
          "kind": "Document",
          "hash": "sha256:b31852c5cfaf13ec80b66bebe4ca12068d033d230ff5976cba8c244ab58103a4",
          "title": "Human-authorized agents and revocation",
          "language": "en",
          "text": "The handle owner authorizes an agent on chain. Agent publications use EIP-712 signatures and remain semantically separate from direct human authorship. Prepare recovers AgentDocument; finalize checks a fresh AgentDocumentFinalization signature bound to the broadcast transaction hash. Neither a document registration ID nor an app session substitutes for the agent signature. Revocation is recorded only after a matching AgentRevoked event, including service and MCP flows."
        },
        {
          "kind": "Document",
          "title": "Libro logical data model",
          "language": "en",
          "text": "Canonical identities own canonical publications. Human and agent signatures remain distinct proof classes. OAuth grants and tokens are identity-scoped; signing challenges bind exact operations. Durable outbox events synchronize consumers. Libro uses its own dedicated database. No production records or required seed records are supplied.",
          "hash": "sha256:86df9ea5f98b8bcdfd292c008cb200d1dd29b59470394d36cd72629caed872f5"
        }
      ],
