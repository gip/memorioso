{
  "name": "memorioso",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-openship.mjs",
    "build": "next build",
    "postinstall": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-openship.mjs --lenient",
    "openship:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-openship.mjs",
    "openship:manifest": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/openship-manifest.mjs --write",
    "openship:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/openship-manifest.mjs",
    "openship:skill": "openship verify-skill skills/openship",
    "openship:worker": "node --import ./scripts/openship-resolve.mjs scripts/openship-worker.mjs",
    "start": "next start",
    "pretest": "openship verify-skill skills/openship",
    "lint": "eslint .",
    "test": "vitest run",
    "db:init": "node scripts/init-db.mjs",
    "db:migrate": "node scripts/migrate-db.mjs",
    "libro:migrate:dry-run": "node scripts/migrate-to-libro-service.mjs --dry-run",
    "libro:migrate": "node scripts/migrate-to-libro-service.mjs",
    "libro:core:check": "pnpm --filter @libro/core check",
    "extension:build": "pnpm --filter @libro/chrome-extension build",
    "extension:build:stage": "pnpm --filter @libro/chrome-extension build:stage",
    "extension:test": "pnpm --filter @libro/chrome-extension test"
  },
  "dependencies": {
    "@libro/core": "workspace:*",
    "@openship/protocol": "0.0.3",
    "@radix-ui/react-dialog": "1.1.5",
    "@radix-ui/react-dropdown-menu": "2.1.5",
    "@radix-ui/react-select": "2.1.5",
    "@radix-ui/react-separator": "1.1.1",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-visually-hidden": "1.1.1",
    "@tiptap/extension-code-block-lowlight": "^2.10.3",
    "@tiptap/extension-document": "^2.10.3",
    "@tiptap/extension-heading": "^2.10.3",
    "@tiptap/extension-image": "^2.10.3",
    "@tiptap/extension-link": "^2.10.3",
    "@tiptap/extension-paragraph": "^2.10.3",
    "@tiptap/extension-placeholder": "^2.10.3",
    "@tiptap/extension-text": "^2.10.3",
    "@tiptap/extension-underline": "^2.10.3",
    "@tiptap/pm": "^2.10.3",
    "@tiptap/react": "^2.10.3",
    "@tiptap/starter-kit": "^2.10.3",
    "@vercel/analytics": "^1.5.0",
    "@worldcoin/idkit": "4.2.2",
    "@worldcoin/idkit-core": "4.2.4",
    "@worldcoin/minikit-js": "2.0.3",
    "@worldcoin/minikit-react": "2.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lowlight": "^3.2.0",
    "lucide-react": "^0.456.0",
    "next": "^16.3.1",
    "pg": "^8.13.1",
    "quill": "2.0.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sanitize-html": "2.17.6",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "tldts": "^7.4.10",
    "viem": "^2.21.10"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/sanitize-html": "2.16.1",
    "@typescript-eslint/parser": "8.64.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "5.7.3",
    "vitest": "^4.1.6",
    "zod": "^4.4.3"
  }
}
