+async function decodeSessionBridgeResponse(payload, options) {
+  await initIDKit();
+  if (payload.error_code) throw new Error(payload.error_code);
+  const proof = payload.proof_response ?? payload;
+  if (proof.error) throw new Error(proof.error);
+  if (!proof.session_id || !Array.isArray(proof.responses)) throw new Error("unexpected_response");
+  if (options.require_user_presence && payload.user_presence_completed !== true) {
+    throw new Error("user_presence_failed");
+  }
+  const result = idkit_wasm_exports.proofResponseToIDKitResult(proof, {
+    nonce: options.nonce,
+    environment: options.environment,
+    signal_hashes: options.signal_hashes,
+    user_presence_completed: options.require_user_presence ? true : undefined,
+    identity_attested: payload.identity_attested,
+  });
+  result.integrity_bundle = payload.integrity_bundle;
+  return result;
+}
+
+exports.decodeSessionBridgeResponse = decodeSessionBridgeResponse;
