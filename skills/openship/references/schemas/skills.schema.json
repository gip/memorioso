{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openship.dev/schemas/skills.schema.json",
  "title": "OpenShip Skills",
  "type": "object",
  "required": [
    "openship",
    "capability",
    "skills"
  ],
  "properties": {
    "openship": {
      "const": "1.0"
    },
    "capability": {
      "const": "skills"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "version",
          "purposes",
          "digest",
          "files"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 64
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "purposes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "understand",
                "build",
                "reuse"
              ]
            }
          },
          "source": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "files": {
            "type": "object",
            "required": [
              "SKILL.md"
            ],
            "properties": {
              "SKILL.md": {
                "type": "object",
                "required": [
                  "encoding",
                  "content"
                ],
                "properties": {
                  "encoding": {
                    "const": "utf-8"
                  },
                  "content": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "additionalProperties": {
              "type": "object",
              "required": [
                "encoding",
                "content"
              ],
              "properties": {
                "encoding": {
                  "enum": [
                    "utf-8",
                    "base64"
                  ]
                },
                "content": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
